{
  "name": "@countersign/web",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types --strict-vars false",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json && tsc -p tsconfig.vite.json",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate": "wrangler d1 migrations apply countersign --local --persist-to ../../.wrangler/state",
    "build:ui": "vite build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@countersign/core": "workspace:*",
    "@countersign/db": "workspace:*",
    "@react-email/editor": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "diff": "^9.0.0",
    "hono": "4.13.13",
    "lucide-react": "^1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "standardwebhooks": "1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19",
    "@types/react-dom": "19",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
