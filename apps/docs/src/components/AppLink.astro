---
import { docsSettings } from "../../site-settings";
const { appUrl } = docsSettings();
---

<a href={appUrl} class="app-link">
  Open app <span aria-hidden="true">↗</span>
</a>
<style>
  .app-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    padding: 0.4rem 0.7rem;
    color: var(--sl-color-white);
    font-size: 0.8rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .app-link:hover {
    background: var(--sl-color-gray-6);
  }
</style>
