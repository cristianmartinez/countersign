{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "countersign-docs",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
  "build": {
    "command": "pnpm --filter @countersign/docs build",
  },
  "env": {
    "production": {
      "name": "countersign-docs-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "countersign-docs.cristianmartinez.co",
          "custom_domain": true,
        },
      ],
      "build": {
        "command": "COUNTERSIGN_APP_URL=https://countersign.cristianmartinez.co COUNTERSIGN_DOCS_URL=https://countersign-docs.cristianmartinez.co pnpm --filter @countersign/docs build",
      },
    },
  },
}
